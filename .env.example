# ClickLess AI — Environment Variables

# Groq API key
GROQ_API_KEY=gsk_key

# Supabase (optional — app works in demo-only mode without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini (primary LLM — free tier, get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter (fallback LLM — falls back to deterministic template summary)
OPENROUTER_API_KEY=sk-or-...

# OpenWeatherMap (optional — demo uses seeded weather data)
OPENWEATHER_API_KEY=your-key

# Duffel (flight search — register free at https://app.duffel.com)
# Only needed to run: npm run seed-cache
# Sandbox keys start with duffel_test_; switch to duffel_live_ for production.
# After seeding, src/lib/cache/*.json are committed to Git — no key needed at runtime.
DUFFEL_API_KEY=duffel_test_your-key-here
DUFFEL_BASE_URL=https://api.duffel.com
